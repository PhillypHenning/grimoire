# BigWigs packager config: builds one zip containing every add-on folder.
package-as: Homunculus

move-folders:
  Homunculus/Homunculus: Homunculus
  Homunculus/Homunculus_Player: Homunculus_Player
  Homunculus/Homunculus_Pet: Homunculus_Pet
  Homunculus/Homunculus_Party: Homunculus_Party
  Homunculus/Homunculus_Target: Homunculus_Target
  Homunculus/Homunculus_Warlock: Homunculus_Warlock
  Homunculus/Homunculus_Auras: Homunculus_Auras
  Homunculus/Homunculus_Bags: Homunculus_Bags
  Homunculus/Homunculus_Bank: Homunculus_Bank
  Homunculus/Homunculus_Auctions: Homunculus_Auctions
  Homunculus/Homunculus_Grimoire: Homunculus_Grimoire
  Homunculus/Homunculus_Launcher: Homunculus_Launcher
  Homunculus/Homunculus_Tweaks: Homunculus_Tweaks
  Homunculus/Homunculus_Prophecy: Homunculus_Prophecy
  Homunculus/Homunculus_Tempo: Homunculus_Tempo
  Homunculus/Homunculus_Emotes: Homunculus_Emotes
  Homunculus/Homunculus_Debug: Homunculus_Debug
  Homunculus/Homunculus_Map: Homunculus_Map

ignore:
  - scripts
  - docs
  - README.md
  - .vscode
  - .luarc.json
