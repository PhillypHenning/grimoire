# BigWigs packager config: builds one zip containing every add-on folder.
package-as: Grimoire

move-folders:
  Grimoire/Grimoire: Grimoire
  Grimoire/Grimoire_Player: Grimoire_Player
  Grimoire/Grimoire_Pet: Grimoire_Pet
  Grimoire/Grimoire_Party: Grimoire_Party
  Grimoire/Grimoire_Target: Grimoire_Target
  Grimoire/Grimoire_Warlock: Grimoire_Warlock
  Grimoire/Grimoire_Auras: Grimoire_Auras
  Grimoire/Grimoire_Bags: Grimoire_Bags
  Grimoire/Grimoire_Bank: Grimoire_Bank
  Grimoire/Grimoire_Auctions: Grimoire_Auctions
  Grimoire/Grimoire_Notes: Grimoire_Notes
  Grimoire/Grimoire_Launcher: Grimoire_Launcher
  Grimoire/Grimoire_Tweaks: Grimoire_Tweaks
  Grimoire/Grimoire_Prophecy: Grimoire_Prophecy
  Grimoire/Grimoire_Tempo: Grimoire_Tempo
  Grimoire/Grimoire_Emotes: Grimoire_Emotes

ignore:
  - scripts
  - docs
  - README.md
  - .vscode
  - .luarc.json
